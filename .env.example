# 1. Database URL (SQLite by default for local dev).
#    For PostgreSQL (Render): postgresql://user:pass@host:5432/fare_calculator
#    Leave empty to use a local SQLite file (backend/fares.db).
DATABASE_URL=

# 2. CORS allowed origins (comma-separated).
#    For Render, include your frontend domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 3. Get a free API key at https://openweathermap.org/ (takes 10-15min to activate)
#    The app calls: https://api.openweathermap.org/data/2.5/weather?q=Tulua,co&appid=YOUR_KEY
#    Weather check is for rain surcharge in Tuluá (lat=4.0847, lon=-76.1954)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. Google Maps API key — enable Places API + Geocoding API in Google Cloud Console.
#    Used for address autocomplete (/api/geocode/search) and coordinate resolution.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 5. Choose any password. You'll use it to log into the /admin panel.
ADMIN_PASSWORD=your_admin_password_here

# 6. Generate a random string for session cookie signing (e.g. from `openssl rand -hex 32`)
SESSION_SECRET=generate_a_random_secret_here

# 7. WhatsApp number used for the "Send to WhatsApp" button in the frontend.
#    Must include country code without + (e.g. 57300XXXXXXX for Colombia).
#    The frontend fetches this via GET /api/config/whatsapp.
WHATSAPP_NUMBER=573001234567
